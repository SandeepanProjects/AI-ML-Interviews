    # Extract tenant_id
    return UserContext(
        tenant_id="tenant_a"
    )


ADAPTER_MAPPING = {
    "tenant_a": "finance",
    "tenant_b": "support",
    "tenant_c": "legal"
}


async def get_adapter(
    user: UserContext
) -> str:

    adapter = ADAPTER_MAPPING.get(
        user.tenant_id
    )

    if not adapter:
        raise HTTPException(
            status_code=404,
            detail="No model configured"
        )

    return adapter


@app.post("/generate")
async def generate_response(
    request: GenerateRequest,
    user: UserContext = Depends(
        get_current_user
    )
):

    adapter = await get_adapter(
        user
