    async with httpx.AsyncClient(
        timeout=60
    ) as client:

        response = await client.post(
            "http://vllm:8000/v1/completions",
            json={
                "model": adapter,
                "prompt": request.prompt,
                "max_tokens": 512,
                "temperature": 0
            }
        )

    response.raise_for_status()

    return response.json()
